# Public base URL used for canonical links, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://ichalkaranji.example

# Official links shown in the footer and quick links (independent portal links OUT to these).
NEXT_PUBLIC_IMC_URL=https://ichalkaranjimnp.in
NEXT_PUBLIC_DISTRICT_URL=https://kolhapur.gov.in

# Optional (Phase 4): Mapbox token. Leave empty to use OpenStreetMap tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Portal team inbox used by the /contact form (opens the visitor's mail app).
# Leave empty to keep the form disabled. Use a team address, not a personal one.
NEXT_PUBLIC_CONTACT_EMAIL=
